# GitHub uses the last matching pattern to select the code owners.
# Required team approvals are configured separately in the master ruleset.

# Frontend developers and QA share default ownership.
* @hmcts/opal-frontend-developers @hmcts/opal-testers

# Admins own build, deployment, toolchain, and API-generation configuration.
/.nvmrc @hmcts/opal-admins
/.yarnrc.yml @hmcts/opal-admins
/.yarn/** @hmcts/opal-admins
/angular.json @hmcts/opal-admins
/tsconfig*.json @hmcts/opal-admins
/Dockerfile* @hmcts/opal-admins
/Jenkinsfile* @hmcts/opal-admins
/charts/** @hmcts/opal-admins
/config/** @hmcts/opal-admins
/.github/** @hmcts/opal-admins
/openapi/** @hmcts/opal-admins
/openapitools.json @hmcts/opal-admins
/scripts/generate-openapi.cjs @hmcts/opal-admins
/scripts/postprocess-openapi-merged.cjs @hmcts/opal-admins

# Leave dependency manifests without a Code Owner requirement for all PR authors.
# Overall approvals and CI still apply; team-review exclusions belong in the ruleset.
/package.json
/yarn.lock
