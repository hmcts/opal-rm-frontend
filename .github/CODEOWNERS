/angular.json @hmcts/opal-admins
/tsconfig*.json @hmcts/opal-admins
/Dockerfile* @hmcts/opal-admins
/Jenkinsfile* @hmcts/opal-admins
/charts/** @hmcts/opal-admins
/config/** @hmcts/opal-admins
/.github/** @hmcts/opal-admins
/openapi/** @hmcts/opal-admins
/openapitools.json @hmcts/opal-admins
/scripts/generate-openapi.cjs @hmcts/opal-admins
/scripts/postprocess-openapi-merged.cjs @hmcts/opal-admins
